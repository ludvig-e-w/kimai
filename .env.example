# Copy to .env and replace every value. Never commit .env
KIMAI_VERSION=stable
KIMAI_PORT=8001

# Database
DB_NAME=kimai
DB_USER=kimai
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Kimai app
# generate with: openssl rand -hex 32
APP_SECRET=change-me-32-byte-hex
# comma separated hostnames Kimai will answer for
TRUSTED_HOSTS=localhost|127.0.0.1
# set to your reverse proxy subnet in production, e.g. 172.16.0.0/12
TRUSTED_PROXIES=

# First-boot super admin
ADMIN_MAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# Mail (optional). null://null disables sending.
MAILER_URL=null://null
MAILER_FROM=kimai@example.com
